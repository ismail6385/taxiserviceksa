{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deployment. Built with @opennextjs/cloudflare — see
  // open-next.config.ts, custom-worker.ts and scripts/dedupe-rsc-manifests.mjs.
  "name": "taxiserviceksa",
  "main": "custom-worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "taxiserviceksa"
    }
  ],
  // next/image optimization via Cloudflare Images (free plan: 5,000 unique
  // transformations/month)
  "images": {
    "binding": "IMAGES"
  },
  // Same daily jobs as vercel.json / netlify/functions (times are UTC)
  "triggers": {
    "crons": ["0 6 * * *", "0 8 * * *"]
  },
  "observability": {
    "enabled": true
  },
  // Run the Worker near Supabase instead of the visitor's city. On
  // 2026-11-23 every Worker -> Supabase request from the Karachi (KHI)
  // data centre timed out (522) while Supabase itself was fine, so the
  // owner (in Pakistan) could not save bookings. Smart Placement also cuts
  // the round trips for the multi-query admin routes. Static pages are
  // unaffected (served from assets).
  "placement": {
    "mode": "smart"
  }
}
